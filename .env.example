# Contact form — set these as Cloudflare Pages project secrets (Settings → Environment variables).
# Local testing: copy to .env and run `npx wrangler pages dev dist`.

# Google Workspace SMTP (app password requires 2FA on the account)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=website@mkm.au
SMTP_PASS=your-google-app-password

# Where contact form submissions are delivered
CONTACT_TO=mkm@mkm.au

---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const tel = site.phone.replace(/\s/g, '');
---

<Base
  title="Contact Us"
  description="Get in touch with MKM Structural Steel for structural steel detailing, fabrication and erection across Victoria."
>
  <section class="section--tight" style="padding-top: clamp(3rem, 6vw, 5rem)">
    <div class="container">
      <p class="spec reveal">Get in touch</p>
      <h1 class="display-xl reveal" style="margin:1rem 0 1.5rem">Contact Us</h1>
      <p class="lede reveal">
        Send through your drawings, your dates and your site — we'll come back
        with a price and a programme.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="contact-primary reveal">
        {
          site.phone && (
            <a class="contact-card" href={`tel:${tel}`}>
              <span class="spec spec--plain">Phone</span>
              <span class="contact-card__value">{site.phone}</span>
              <span class="contact-card__note">Mon–Fri, site hours</span>
            </a>
          )
        }
        <a class="contact-card" href={`mailto:${site.email}`}>
          <span class="spec spec--plain">Email</span>
          <span class="contact-card__value contact-card__value--email">{site.email}</span>
          <span class="contact-card__note">Drawings and plans welcome</span>
        </a>
      </div>

      <div class="contact-meta reveal" style="--reveal-delay:.1s">
        <div class="contact-block">
          <p class="spec spec--plain">Workshop</p>
          <p class="contact-meta__value">{site.address}</p>
        </div>
        <div class="contact-block">
          <p class="spec spec--plain">Coverage</p>
          <p class="contact-meta__value">All of Victoria</p>
        </div>
        {
          site.abn && (
            <div class="contact-block">
              <p class="spec spec--plain">ABN</p>
              <p class="contact-meta__value">{site.abn}</p>
            </div>
          )
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .contact-primary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(16rem, 1fr));
    gap: 1.25rem;
  }
  .contact-card {
    display: grid;
    gap: 0.7rem;
    align-content: start;
    padding: clamp(1.5rem, 3vw, 2.25rem);
    background: var(--surface-1);
    border: 1px solid var(--line);
    border-left: 3px solid var(--accent);
    text-decoration: none;
    transition:
      border-color 0.2s ease,
      transform 0.2s ease;
  }
  .contact-card:hover {
    border-color: var(--line-strong);
    border-left-color: var(--accent);
    transform: translateY(-2px);
  }
  .contact-card__value {
    font-family: var(--font-display);
    font-size: clamp(1.6rem, 3.4vw, 2.4rem);
    font-weight: 720;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.05;
    color: var(--ink);
  }
  /* email is longer and case-sensitive — keep it readable, not shouted */
  .contact-card__value--email {
    font-size: clamp(1.1rem, 2.2vw, 1.5rem);
    text-transform: none;
    word-break: break-word;
  }
  .contact-card:hover .contact-card__value { color: var(--accent); }
  .contact-card__note {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--ink-faint);
  }

  .contact-meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(12rem, 1fr));
    gap: 2rem;
    margin-top: clamp(2.5rem, 5vw, 3.5rem);
  }
  .contact-block { display: grid; gap: 0.6rem; }
  .contact-meta__value {
    font-family: var(--font-display);
    font-size: clamp(1.15rem, 2vw, 1.4rem);
    font-weight: 720;
    text-transform: uppercase;
    letter-spacing: 0.02em;
    line-height: 1.15;
    color: var(--ink);
  }
</style>

---
import { getCollection, getEntry, render } from 'astro:content';
import Base from '../layouts/Base.astro';
import site from '../data/site.json';

const about = await getEntry('pages', 'about');
const AboutContent = about ? (await render(about)).Content : null;
const staff = (await getCollection('staff')).sort(
  (a, b) => a.data.order - b.data.order
);
---

<Base
  title="About Us"
  description="MKM Structural Steel — a Victorian steel fabricator covering detailing, steelwork, fabrication and erection under one roof."
>
  <section class="section--tight" style="padding-top: clamp(3rem, 6vw, 5rem)">
    <div class="container">
      <p class="spec reveal">The company</p>
      <h1 class="display-xl reveal" style="margin:1rem 0 2.5rem">About Us</h1>
      <div class="about-grid">
        <div class="prose lede reveal">
          {AboutContent && <AboutContent />}
        </div>
        <div class="about-services reveal" style="--reveal-delay:.1s">
          {
            site.services.map((s, i) => (
              <div class="about-service">
                <span>0{i + 1}</span>
                <strong class="display-sm">{s.title}</strong>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <!-- process -->
  <section class="blueprint section">
    <div class="container">
      <p class="spec reveal">How we work</p>
      <h2 class="display-lg reveal" style="margin:1rem 0 3rem">
        Drawing office to standing steel
      </h2>
      <ol class="process">
        {
          [
            ['Detail', 'Shop drawings and connection design resolved in 3D before fabrication begins.'],
            ['Fabricate', 'Cut, drilled and welded in our workshop to AS/NZS standards, with QA at every stage.'],
            ['Erect', 'Our own crews crane, rig and bolt the steel — one point of responsibility to handover.'],
          ].map(([title, text], i) => (
            <li class="process__step reveal" style={`--reveal-delay:${i * 0.1}s`}>
              <span class="process__num display">{`0${i + 1}`}</span>
              <h3 class="display-sm">{title}</h3>
              <p>{text}</p>
            </li>
          ))
        }
      </ol>
    </div>
  </section>

  <!-- team -->
  <section class="section">
    <div class="container">
      <p class="spec reveal">The people</p>
      <h2 class="display-lg reveal" style="margin:1rem 0 3rem">Our team</h2>
      <div class="team">
        {
          staff.map(async (person, i) => {
            const { Content: Bio } = await render(person);
            return (
              <article class="member reveal" style={`--reveal-delay:${i * 0.08}s`}>
                <div class="member__photo">
                  {person.data.photo ? (
                    <img src={person.data.photo} alt={person.data.name} loading="lazy" />
                  ) : (
                    <span class="member__initial display">
                      {person.data.name.charAt(0)}
                    </span>
                  )}
                </div>
                <h3 class="display-sm">{person.data.name}</h3>
                <p class="member__role">{person.data.role}</p>
                <div class="member__bio">
                  <Bio />
                </div>
              </article>
            );
          })
        }
      </div>
    </div>
  </section>
</Base>

<style>
  .about-grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  .prose :global(p) { margin-bottom: 1.1rem; }
  .about-services { display: grid; border-top: 1px solid var(--line); }
  .about-service {
    display: flex;
    align-items: baseline;
    gap: 1.1rem;
    padding: 1.1rem 0;
    border-bottom: 1px solid var(--line);
  }
  .about-service span {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--weld);
  }
  @media (max-width: 820px) { .about-grid { grid-template-columns: 1fr; } }

  .process {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 2rem;
  }
  .process__step {
    border-top: 3px solid var(--weld);
    padding-top: 1.3rem;
    display: grid;
    gap: 0.7rem;
    align-content: start;
  }
  .process__num {
    font-size: 2.6rem;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(236, 233, 226, 0.5);
  }
  .process__step p { color: rgba(236, 233, 226, 0.75); font-size: 0.95rem; }
  @media (max-width: 760px) { .process { grid-template-columns: 1fr; } }

  .team {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  .member {
    border: 1px solid var(--line);
    background: var(--steel-900);
    padding: 1.5rem;
    display: grid;
    gap: 0.5rem;
    align-content: start;
  }
  .member__photo {
    aspect-ratio: 1;
    background: var(--steel-800);
    margin-bottom: 0.8rem;
    display: grid;
    place-items: center;
    overflow: hidden;
  }
  .member__photo img { width: 100%; height: 100%; object-fit: cover; }
  .member__initial {
    font-size: 5rem;
    color: transparent;
    -webkit-text-stroke: 2px var(--weld);
  }
  .member__role {
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--weld);
  }
  .member__bio { color: var(--paper-dim); font-size: 0.92rem; line-height: 1.6; }
  .member__bio :global(p) { margin: 0; }
  @media (max-width: 980px) { .team { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 600px) { .team { grid-template-columns: 1fr; } }
</style>

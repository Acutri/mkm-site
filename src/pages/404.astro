---
import Base from '../layouts/Base.astro';
---

<Base title="Page not found">
  <section class="section" style="min-height: 55vh; display: grid; align-items: center;">
    <div class="container">
      <p class="spec">Error 404</p>
      <h1 class="display-xl" style="margin:1rem 0 1.5rem">
        Nothing<br />standing here.
      </h1>
      <p class="lede" style="margin-bottom:2rem">
        The page you're after has been demo'd or never existed.
      </p>
      <a class="btn btn--solid" href="/">Back to home</a>
    </div>
  </section>
</Base>

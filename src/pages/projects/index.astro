---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import ProjectCard from '../../components/ProjectCard.astro';
import ProjectMap from '../../components/ProjectMap.astro';

const projects = (await getCollection('projects', ({ data }) => !data.draft))
  .sort((a, b) => (b.data.year ?? 0) - (a.data.year ?? 0));
const categories = [...new Set(projects.map((p) => p.data.category))].sort();
---

<Base
  title="Projects"
  description="Structural steel projects detailed, fabricated and erected by MKM Structural Steel across Victoria."
>
  <section class="section--tight" style="padding-top: clamp(3rem, 6vw, 5rem)">
    <div class="container">
      <p class="spec reveal">Portfolio</p>
      <h1 class="display-xl reveal" style="margin:1rem 0 1.5rem">Projects</h1>
      <p class="lede reveal">
        Standing steel across Victoria — commercial, industrial, education and
        agricultural work, all delivered by the one team.
      </p>
    </div>
  </section>

  <section class="section--tight">
    <div class="container">
      <div class="filters reveal" role="group" aria-label="Filter projects by category">
        <button class="filter is-active" data-filter="all">
          All <span>{projects.length}</span>
        </button>
        {
          categories.map((c) => (
            <button class="filter" data-filter={c}>
              {c} <span>{projects.filter((p) => p.data.category === c).length}</span>
            </button>
          ))
        }
      </div>

      <div class="card-grid" data-project-grid>
        {
          projects.map((p, i) => (
            <ProjectCard
              slug={p.id}
              title={p.data.title}
              location={p.data.location}
              year={p.data.year}
              category={p.data.category}
              cover={p.data.cover}
              summary={p.data.summary}
              delay={Math.min(i, 5) * 0.06}
            />
          ))
        }
      </div>
      <p class="filters__empty" data-filter-empty hidden>
        No projects in this category yet.
      </p>
    </div>
  </section>

  <section class="blueprint section" id="map">
    <div class="container">
      <p class="spec reveal">Project map</p>
      <h2 class="display-lg reveal" style="margin:1rem 0 2.5rem">
        Everywhere we've built
      </h2>
      <div class="reveal">
        <ProjectMap />
      </div>
      <p class="map-note">
        Click a pin to open the project. Zoom activates after clicking the map.
      </p>
    </div>
  </section>
</Base>

<style>
  .filters {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
    margin-bottom: 2.5rem;
  }
  .filter {
    font-family: var(--font-mono);
    font-size: 0.75rem;
    font-weight: 500;
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-dim);
    background: transparent;
    border: 1px solid var(--line-strong);
    padding: 0.55rem 1rem;
    cursor: pointer;
    transition: all 0.2s ease;
  }
  .filter span { color: var(--ink-faint); margin-left: 0.35rem; }
  .filter:hover { border-color: var(--accent); color: var(--ink); }
  .filter.is-active {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--surface-0);
  }
  .filter.is-active span { color: color-mix(in srgb, var(--surface-0) 70%, transparent); }

  .card-grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1.5rem;
  }
  @media (max-width: 980px) { .card-grid { grid-template-columns: 1fr 1fr; } }
  @media (max-width: 640px) { .card-grid { grid-template-columns: 1fr; } }

  .filters__empty { color: var(--ink-dim); padding-block: 2rem; }

  .map-note {
    margin-top: 1rem;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.12em;
    color: rgba(236, 233, 226, 0.55);
  }
</style>

<script>
  const buttons = document.querySelectorAll<HTMLButtonElement>('.filter');
  const cards = document.querySelectorAll<HTMLElement>('[data-project-grid] [data-category]');
  const empty = document.querySelector<HTMLElement>('[data-filter-empty]');

  buttons.forEach((btn) => {
    btn.addEventListener('click', () => {
      buttons.forEach((b) => b.classList.remove('is-active'));
      btn.classList.add('is-active');
      const f = btn.dataset.filter;
      let visible = 0;
      cards.forEach((card) => {
        const show = f === 'all' || card.dataset.category === f;
        card.style.display = show ? '' : 'none';
        if (show) visible++;
      });
      if (empty) empty.hidden = visible > 0;
    });
  });
</script>

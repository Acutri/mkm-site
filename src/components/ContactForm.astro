---
---

<div class="form-status" data-form-status hidden>
  <p data-status-sent hidden>
    Thanks — your message is on its way. We'll be in touch shortly.
  </p>
  <p data-status-error hidden>
    Something went wrong sending your message. Please try again, or email us
    directly.
  </p>
</div>

<form class="contact-form" method="post" action="/api/contact">
  <div class="contact-form__row">
    <div class="field">
      <label for="cf-name">Name *</label>
      <input id="cf-name" name="name" type="text" required autocomplete="name" />
    </div>
    <div class="field">
      <label for="cf-phone">Phone</label>
      <input id="cf-phone" name="phone" type="tel" autocomplete="tel" />
    </div>
  </div>
  <div class="field">
    <label for="cf-email">Email *</label>
    <input id="cf-email" name="email" type="email" required autocomplete="email" />
  </div>
  <div class="field">
    <label for="cf-message">How can we help? *</label>
    <textarea id="cf-message" name="message" rows="6" required></textarea>
  </div>

  <!-- honeypot — humans never see this -->
  <div class="hp" aria-hidden="true">
    <label for="cf-company-website">Company website</label>
    <input id="cf-company-website" name="company_website" type="text" tabindex="-1" autocomplete="off" />
  </div>

  <button class="btn btn--solid" type="submit">Send message</button>
</form>

<style>
  .contact-form { display: grid; gap: 1.3rem; }
  .contact-form__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.3rem;
  }
  @media (max-width: 600px) {
    .contact-form__row { grid-template-columns: 1fr; }
  }
  .hp {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .form-status { border-left: 3px solid var(--accent); padding: 1rem 1.2rem; background: var(--surface-2); margin-bottom: 1.5rem; }
  .form-status p { margin: 0; }
</style>

<script>
  const params = new URLSearchParams(location.search);
  const wrap = document.querySelector<HTMLElement>('[data-form-status]');
  if (wrap && (params.has('sent') || params.has('error'))) {
    wrap.hidden = false;
    const sent = wrap.querySelector<HTMLElement>('[data-status-sent]');
    const err = wrap.querySelector<HTMLElement>('[data-status-error]');
    if (params.has('sent') && sent) sent.hidden = false;
    if (params.has('error') && err) err.hidden = false;
    wrap.scrollIntoView({ block: 'center', behavior: 'smooth' });
  }
</script>

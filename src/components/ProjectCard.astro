---
interface Props {
  slug: string;
  title: string;
  location: string;
  year?: number | undefined;
  category: string;
  cover?: string | undefined;
  summary?: string | undefined;
  delay?: number;
}
const { slug, title, location, year, category, cover, summary, delay = 0 } = Astro.props;
---

<a
  href={`/projects/${slug}`}
  class="card reveal"
  style={`--reveal-delay:${delay}s`}
  data-category={category}
>
  <div class="card__media">
    {cover && <img src={cover} alt={title} loading="lazy" width="800" height="500" />}
    <span class="card__tag">{category}</span>
  </div>
  <div class="card__body">
    <div class="card__meta">
      <span>{location}</span>
      {year && <span>{year}</span>}
    </div>
    <h3 class="card__title">{title}</h3>
    {summary && <p class="card__summary">{summary}</p>}
    <span class="card__more" aria-hidden="true">View project →</span>
  </div>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    text-decoration: none;
    background: var(--steel-900);
    border: 1px solid var(--line);
    transition: border-color 0.25s ease, transform 0.25s ease;
  }
  .card:hover { border-color: var(--weld); transform: translateY(-4px); }
  .card__media {
    position: relative;
    aspect-ratio: 16 / 10;
    overflow: hidden;
    background: var(--steel-800);
  }
  .card__media img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    filter: saturate(0.85) contrast(1.02);
    transition: transform 0.5s cubic-bezier(0.22, 1, 0.36, 1), filter 0.3s ease;
  }
  .card:hover .card__media img { transform: scale(1.045); filter: saturate(1); }
  .card__tag {
    position: absolute;
    left: 0;
    bottom: 0;
    background: var(--steel-950);
    color: var(--weld);
    font-family: var(--font-mono);
    font-size: 0.68rem;
    font-weight: 500;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    padding: 0.4rem 0.75rem;
    border-top: 1px solid var(--line);
    border-right: 1px solid var(--line);
  }
  .card__body { padding: 1.35rem 1.35rem 1.5rem; display: grid; gap: 0.55rem; }
  .card__meta {
    display: flex;
    justify-content: space-between;
    font-family: var(--font-mono);
    font-size: 0.72rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--paper-faint);
  }
  .card__title {
    font-size: clamp(1.35rem, 2vw, 1.7rem);
    color: var(--paper);
  }
  .card__summary {
    color: var(--paper-dim);
    font-size: 0.92rem;
    line-height: 1.55;
    display: -webkit-box;
    -webkit-line-clamp: 2;
    -webkit-box-orient: vertical;
    overflow: hidden;
  }
  .card__more {
    margin-top: 0.4rem;
    font-family: var(--font-mono);
    font-size: 0.74rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--weld);
    opacity: 0;
    transform: translateX(-6px);
    transition: opacity 0.25s ease, transform 0.25s ease;
  }
  .card:hover .card__more { opacity: 1; transform: none; }
</style>

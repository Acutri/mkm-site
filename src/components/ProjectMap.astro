---
interface Props {
  height?: string;
}
const { height = 'clamp(420px, 60vh, 640px)' } = Astro.props;
---

<div class="map-frame">
  <div class="map-frame__corner map-frame__corner--tl" aria-hidden="true"></div>
  <div class="map-frame__corner map-frame__corner--br" aria-hidden="true"></div>
  <div id="project-map" style={`height:${height}`}></div>
</div>

<style is:global>
  .map-frame {
    position: relative;
    border: 1px solid var(--line-strong);
  }
  .map-frame__corner {
    position: absolute;
    width: 22px;
    height: 22px;
    z-index: 500;
    pointer-events: none;
  }
  .map-frame__corner--tl {
    top: -1px; left: -1px;
    border-top: 3px solid var(--weld);
    border-left: 3px solid var(--weld);
  }
  .map-frame__corner--br {
    bottom: -1px; right: -1px;
    border-bottom: 3px solid var(--weld);
    border-right: 3px solid var(--weld);
  }
  #project-map { background: var(--steel-900); z-index: 1; }

  /* darken OSM tiles to match the theme */
  #project-map .leaflet-tile-pane {
    filter: grayscale(1) invert(0.92) contrast(0.86) brightness(0.9) sepia(0.14);
  }
  #project-map .leaflet-control-attribution {
    background: rgba(14, 15, 18, 0.8);
    color: var(--paper-faint);
    font-family: var(--font-mono);
    font-size: 0.6rem;
  }
  #project-map .leaflet-control-attribution a { color: var(--paper-dim); }
  #project-map .leaflet-control-zoom a {
    background: var(--steel-850);
    color: var(--paper);
    border-color: var(--line-strong);
  }
  #project-map .leaflet-control-zoom a:hover { background: var(--steel-700); }

  .mkm-pin {
    display: grid;
    place-items: center;
  }
  .mkm-pin span {
    width: 14px;
    height: 14px;
    background: var(--weld);
    border: 2px solid var(--steel-950);
    transform: rotate(45deg);
    box-shadow: 0 0 0 2px color-mix(in srgb, var(--weld) 45%, transparent);
    transition: transform 0.15s ease;
  }
  .mkm-pin:hover span { transform: rotate(45deg) scale(1.25); }

  .mkm-cluster {
    background: var(--navy);
    color: var(--paper);
    border: 2px solid var(--weld);
    border-radius: 0;
    display: grid;
    place-items: center;
    font-family: var(--font-mono);
    font-weight: 600;
    font-size: 0.8rem;
  }

  .leaflet-popup-content-wrapper {
    background: var(--steel-850);
    color: var(--paper);
    border-radius: 0;
    border: 1px solid var(--line-strong);
    box-shadow: 0 12px 30px rgba(0, 0, 0, 0.5);
  }
  .leaflet-popup-tip { background: var(--steel-850); }
  .leaflet-popup-content { margin: 0; width: 240px !important; }
  .mkm-popup { text-decoration: none; display: block; }
  .mkm-popup img { width: 100%; height: 120px; object-fit: cover; display: block; }
  .mkm-popup__body { padding: 0.8rem 0.9rem 0.9rem; }
  .mkm-popup__meta {
    font-family: var(--font-mono);
    font-size: 0.62rem;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--weld);
    display: flex;
    justify-content: space-between;
    margin-bottom: 0.3rem;
  }
  .mkm-popup__title {
    font-family: var(--font-display);
    font-size: 1.05rem;
    font-weight: 750;
    text-transform: uppercase;
    color: var(--paper);
    line-height: 1.05;
  }
  .leaflet-popup-close-button { color: var(--paper-dim) !important; }
</style>

<script>
  import L from 'leaflet';
  import 'leaflet/dist/leaflet.css';
  import 'leaflet.markercluster';
  import 'leaflet.markercluster/dist/MarkerCluster.css';

  interface MapProject {
    slug: string;
    title: string;
    location: string;
    year?: number;
    category: string;
    cover?: string;
    lat: number;
    lng: number;
  }

  const el = document.getElementById('project-map');
  if (el) {
    const map = L.map(el, {
      center: [-36.9, 144.8], // Victoria
      zoom: 7,
      minZoom: 5,
      scrollWheelZoom: false,
    });

    L.tileLayer('https://tile.openstreetmap.org/{z}/{x}/{y}.png', {
      maxZoom: 18,
      attribution: '&copy; <a href="https://www.openstreetmap.org/copyright">OpenStreetMap</a>',
    }).addTo(map);

    // scroll zoom only after click, so page scrolling isn't hijacked
    map.on('click', () => map.scrollWheelZoom.enable());

    const icon = L.divIcon({
      className: 'mkm-pin',
      html: '<span></span>',
      iconSize: [22, 22],
      iconAnchor: [11, 11],
      popupAnchor: [0, -12],
    });

    const cluster = L.markerClusterGroup({
      maxClusterRadius: 44,
      iconCreateFunction: (c) =>
        L.divIcon({
          className: 'mkm-cluster',
          html: String(c.getChildCount()),
          iconSize: [34, 34],
        }),
    });

    const esc = (s: string) =>
      s.replace(/[&<>"']/g, (ch) => `&#${ch.charCodeAt(0)};`);

    fetch('/projects.json')
      .then((r) => r.json())
      .then((projects: MapProject[]) => {
        for (const p of projects) {
          const marker = L.marker([p.lat, p.lng], { icon, title: p.title });
          marker.bindPopup(
            `<a class="mkm-popup" href="/projects/${esc(p.slug)}">` +
              (p.cover ? `<img src="${esc(p.cover)}" alt="" />` : '') +
              `<div class="mkm-popup__body">` +
              `<div class="mkm-popup__meta"><span>${esc(p.location)}</span><span>${p.year ?? ''}</span></div>` +
              `<div class="mkm-popup__title">${esc(p.title)}</div>` +
              `</div></a>`,
            { closeButton: true }
          );
          cluster.addLayer(marker);
        }
        map.addLayer(cluster);
        if (projects.length) {
          map.fitBounds(cluster.getBounds().pad(0.15), { maxZoom: 9 });
        }
      });
  }
</script>
